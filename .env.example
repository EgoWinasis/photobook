# Google Cloud service account JSON, minified onto ONE line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Google Drive folder ID for the root folder containing your moment folders
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id

# Login credentials. Username accepts dita or ego (case-insensitive).
LOGIN_PASSWORD=change-this-to-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional site title
NEXT_PUBLIC_SITE_TITLE=Forever With You